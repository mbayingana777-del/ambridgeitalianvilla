<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Ambridge Italian Villa</title>

<style>
/* ---------- GLOBAL ---------- */
*{margin:0;padding:0;box-sizing:border-box;}
html, body{overflow-x:hidden;scroll-behavior:smooth;}

:root{
  --gold:#f7c948;
  --gold-dark:#ddb22f;
  --bg:#0d0d0d;
  --panel:#171717;
  --panel-2:#111;
  --line:rgba(255,255,255,.1);
  --text:#fff;
  --muted:rgba(255,255,255,.82);
  --muted-2:rgba(255,255,255,.68);
  --shadow:0 18px 40px rgba(0,0,0,.35);
  --radius:18px;
}

body{
  font-family:"Helvetica Neue", Arial, sans-serif;
  color:var(--text);
  background:url("villa-bg.jpg") center/cover no-repeat fixed;
  position:relative;
}

/* DARK GRADIENT OVER BACKGROUND */
body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    linear-gradient(to bottom, rgba(0,0,0,.50), rgba(0,0,0,.90)),
    radial-gradient(circle at top center, rgba(247,201,72,.08), transparent 35%);
  z-index:-1;
}

/* ---------- UTILITIES ---------- */
.section-shell{
  width:min(1180px, calc(100% - 2rem));
  margin:0 auto;
}
.section-title{
  font-size:2.7rem;
  margin-bottom:.8rem;
  text-align:center;
}
.section-sub{
  max-width:840px;
  margin:0 auto 2.2rem;
  text-align:center;
  line-height:1.65;
  color:var(--muted);
}
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  text-decoration:none;
  border-radius:999px;
  padding:1rem 1.5rem;
  min-height:44px;
  font-weight:700;
  transition:transform .18s ease, opacity .18s ease, background .18s ease, border-color .18s ease;
}
.btn:hover{transform:translateY(-2px);}
.btn.primary{
  background:var(--gold);
  color:#000;
}
.btn.primary:hover{background:var(--gold-dark);}
.btn.secondary{
  border:2px solid var(--gold);
  color:var(--gold);
  background:transparent;
}
.btn.ghost{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.14);
  color:#fff;
}
.chip{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:.55rem .95rem;
  border-radius:999px;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.1);
  font-size:.95rem;
  color:#fff;
}

/* ---------- HEADER ---------- */
header{
  background:rgba(17,17,17,0.92);
  backdrop-filter: blur(10px);
  padding:.7rem 1.25rem;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:100;
  border-bottom:1px solid rgba(255,255,255,.08);
  gap:1.25rem;
}

header h1{
  display:flex;
  align-items:center;
  line-height:0;
}

header h1 img{
  height:44px;
  width:auto;
  object-fit:contain;
  filter: drop-shadow(0 2px 10px rgba(0,0,0,.75));
  transform: translateZ(0);
}

header h1 img:hover{
  filter: drop-shadow(0 2px 14px rgba(0,0,0,.85));
}

.contact-info-flex{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:1.4rem;
  flex-wrap:wrap;
}
.contact-info-flex p{
  margin:0;
  font-size:.95rem;
  display:flex;
  align-items:center;
  gap:.45rem;
  white-space:nowrap;
  color:var(--muted);
}
.status-dot{
  width:10px;
  height:10px;
  border-radius:50%;
  display:inline-block;
}
.rating{font-weight:700;color:#fff;}

/* ---------- HERO ---------- */
.hero{
  position:relative;
  min-height:92vh;
  overflow:hidden;
  background:url("villa-hero.jpg") center/cover no-repeat;
}

.hero-overlay{
  position:absolute;
  inset:0;
  z-index:2;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:2rem;
  background:linear-gradient(to bottom, rgba(0,0,0,.38), rgba(0,0,0,.90));
}

.hero-inner{
  width:min(980px, 100%);
}

.hero-kicker{
  display:inline-block;
  margin-bottom:1rem;
  padding:.55rem 1rem;
  border-radius:999px;
  background:rgba(247,201,72,.14);
  border:1px solid rgba(247,201,72,.28);
  color:#ffe59a;
  font-weight:700;
  letter-spacing:.02em;
}

.hero-overlay h1{
  font-size:3.35rem;
  line-height:1.05;
  margin-bottom:1rem;
}

.hero-overlay p{
  max-width:860px;
  font-size:1.15rem;
  opacity:.94;
  margin:0 auto 1.7rem;
  line-height:1.7;
  color:var(--muted);
}

.hero-points{
  display:flex;
  flex-wrap:wrap;
  gap:.75rem;
  justify-content:center;
  margin-bottom:1.8rem;
}

.hero-actions{
  display:flex;
  gap:1rem;
  flex-wrap:wrap;
  justify-content:center;
  margin-bottom:1.4rem;
}

.hero-meta{
  display:flex;
  gap:.8rem;
  flex-wrap:wrap;
  justify-content:center;
  color:var(--muted);
  font-size:.98rem;
}

/* ---------- QUICK ACTIONS ---------- */
.quick-actions{
  margin-top:-42px;
  position:relative;
  z-index:5;
}
.quick-actions-grid{
  width:min(1180px, calc(100% - 2rem));
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:1rem;
}
.quick-card{
  background:rgba(20,20,20,.94);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:1.25rem;
  box-shadow:var(--shadow);
  text-align:center;
}
.quick-card h3{
  font-size:1.05rem;
  margin-bottom:.4rem;
}
.quick-card p{
  color:var(--muted-2);
  line-height:1.55;
  font-size:.96rem;
}
.quick-card a{
  margin-top:.9rem;
}

/* ---------- FEATURED ---------- */
.featured{
  padding:6rem 0 5rem;
  background:rgba(0,0,0,0.48);
  backdrop-filter: blur(4px);
}
.featured-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:1.5rem;
}
.featured-item{
  background:rgba(23,23,23,.96);
  border:1px solid var(--line);
  border-radius:16px;
  overflow:hidden;
  transition:transform .2s ease, box-shadow .2s ease;
  position:relative;
  padding-top:140px;
  text-align:center;
}
.featured-item:hover{
  transform:translateY(-5px);
  box-shadow:0 15px 35px rgba(0,0,0,.35);
}
.featured-item-img{
  width:140px;
  height:140px;
  border-radius:50%;
  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;
  border:4px solid #222;
  position:absolute;
  top:0;
  left:50%;
  transform:translateX(-50%);
}
.featured-item h4{
  margin:1rem 0 .5rem;
  font-size:1.18rem;
}
.featured-item p{
  opacity:.92;
  font-size:.98rem;
  padding:0 1rem;
  margin:0 0 1.1rem;
  line-height:1.52;
  color:var(--muted);
}
.featured-item a{
  display:inline-block;
  margin-bottom:1.35rem;
  padding:.58rem 1.15rem;
  border-radius:999px;
  background:var(--gold);
  color:#000;
  font-weight:700;
  text-decoration:none;
}

.featured-links{
  margin-top:2rem;
  display:flex;
  flex-wrap:wrap;
  gap:.9rem;
  justify-content:center;
}
.featured-links a{
  display:inline-block;
  padding:.9rem 1.25rem;
  border-radius:999px;
  text-decoration:none;
  font-weight:700;
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.14);
  color:#fff;
}
.featured-links a:hover{
  background:rgba(255,255,255,.12);
}

/* ---------- MENU PREVIEW ---------- */
.menu-preview{
  padding:5.5rem 0;
}
.menu-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:1rem;
}
.menu-card{
  background:rgba(17,17,17,.95);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:1.35rem;
}
.menu-card h3{
  margin-bottom:.8rem;
  font-size:1.18rem;
}
.menu-card ul{
  list-style:none;
}
.menu-card li{
  padding:.45rem 0;
  color:var(--muted);
  border-bottom:1px solid rgba(255,255,255,.06);
}
.menu-card li:last-child{border-bottom:none;}
.menu-bottom{
  margin-top:1.7rem;
  text-align:center;
}

/* ---------- FOOD TRUCK ---------- */
.food-truck{
  padding:5.5rem 0;
  background:rgba(0,0,0,.52);
  backdrop-filter: blur(4px);
}
.truck-wrap{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:1.25rem;
  align-items:stretch;
}
.truck-panel{
  background:rgba(20,20,20,.96);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:1.5rem;
  box-shadow:var(--shadow);
}
.truck-panel h3{
  font-size:1.35rem;
  margin-bottom:.75rem;
}
.truck-panel p{
  color:var(--muted);
  line-height:1.65;
}
.schedule-list{
  display:grid;
  gap:.8rem;
  margin-top:1rem;
}
.schedule-item{
  display:flex;
  justify-content:space-between;
  gap:1rem;
  padding:1rem 1rem;
  border-radius:14px;
  background:rgba(255,255,255,.04);
  border:1px solid rgba(255,255,255,.06);
}
.schedule-item strong{
  display:block;
  margin-bottom:.2rem;
}
.schedule-item span{
  color:var(--muted-2);
  font-size:.95rem;
}
.truck-cta{
  display:flex;
  gap:.8rem;
  flex-wrap:wrap;
  margin-top:1.15rem;
}

/* ---------- STORY ---------- */
.story-wrap{
  padding:5.5rem 0;
}
.story{
  background:#111;
  max-width:1000px;
  margin:0 auto;
  text-align:center;
  border-radius:16px;
  padding:4rem 2rem;
  border:1px solid var(--line);
}
.story h2{
  font-size:2.6rem;
  margin-bottom:1rem;
}
.story .tagline{
  opacity:.95;
  margin-bottom:1.75rem;
}
.story p{
  font-size:1.05rem;
  line-height:1.75;
  opacity:.92;
  margin-bottom:1.25rem;
  color:var(--muted);
}
.story .highlight{
  display:inline-block;
  margin-top:1rem;
  padding:.9rem 1.1rem;
  border-radius:12px;
  background:rgba(247,201,72,.12);
  border:1px solid rgba(247,201,72,.25);
  max-width:900px;
}

/* ---------- HOURS / CONTACT ---------- */
.info-section{
  padding:5.5rem 0 6rem;
  background:rgba(0,0,0,.48);
}
.info-grid{
  display:grid;
  grid-template-columns:.95fr 1.05fr;
  gap:1rem;
}
.info-card{
  background:rgba(17,17,17,.95);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:1.5rem;
}
.info-card h3{
  font-size:1.35rem;
  margin-bottom:1rem;
}
.hours-list{
  display:grid;
  gap:.7rem;
}
.hours-row{
  display:flex;
  justify-content:space-between;
  gap:1rem;
  padding:.85rem 0;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.hours-row:last-child{border-bottom:none;}
.hours-row span{color:var(--muted);}
.contact-stack{
  display:grid;
  gap:.85rem;
}
.contact-stack p{
  color:var(--muted);
  line-height:1.6;
}
.contact-actions{
  display:flex;
  flex-wrap:wrap;
  gap:.8rem;
  margin-top:1rem;
}
.map-frame{
  width:100%;
  height:100%;
  min-height:320px;
  border:0;
  border-radius:14px;
}

/* ---------- FOOTER ---------- */
footer{
  padding:2rem;
  text-align:center;
  background:#0d0d0d;
  opacity:.96;
  color:var(--muted);
  border-top:1px solid rgba(255,255,255,.06);
}
footer strong{color:#fff;}

/* ---------- MOBILE ---------- */
a, button{ -webkit-tap-highlight-color: transparent; }

@media (max-width: 1080px){
  .quick-actions-grid{grid-template-columns:repeat(2,1fr);}
  .menu-grid{grid-template-columns:repeat(2,1fr);}
  .truck-wrap,
  .info-grid{grid-template-columns:1fr;}
}

@media (max-width: 900px){
  header{
    padding:.75rem 1rem;
    gap:1rem;
    flex-direction:column;
    align-items:flex-start;
  }
  header h1{width:100%;justify-content:flex-start;}
  .contact-info-flex{
    width:100%;
    justify-content:flex-start;
    gap:.7rem 1.15rem;
  }
  .section-title{font-size:2.2rem;}
  .hero-overlay h1{font-size:2.7rem;}
}

@media (max-width: 600px){
  header h1 img{height:44px;max-width:80vw;}
  .hero{min-height:84vh;}
  .hero-overlay{padding:1.4rem 1rem;}
  .hero-overlay h1{
    font-size:2.05rem;
    line-height:1.1;
    margin-bottom:.75rem;
  }
  .hero-overlay p{
    font-size:1rem;
    line-height:1.5;
    margin-bottom:1.2rem;
  }
  .hero-actions{width:100%;gap:.75rem;}
  .hero-actions a{width:100%;}
  .hero-meta{font-size:.92rem;}

  .quick-actions{margin-top:-24px;}
  .quick-actions-grid{grid-template-columns:1fr;}

  .featured{padding:4rem 0;}
  .featured-item{padding-top:120px;}
  .featured-item-img{width:120px;height:120px;}

  .menu-grid{grid-template-columns:1fr;}
  .story{
    padding:3.2rem 1.2rem;
  }
  .story h2{font-size:2rem;}
}
</style>
</head>

